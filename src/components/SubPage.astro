---
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import Cta from './Cta.astro';
import Section from './Section.astro';

// sections: [{ title, items, maps }] où items = [{name, desc, maps?}] (cartes) ou [string] (liste)
// section.maps : true ou chaîne de contexte géographique -> lien Google Maps auto sur chaque carte
// item.maps === false : pas de lien pour cette carte
// postcard: { src, alt, caption } -> carte postale ancienne rendue avec sa légende
// features: [{ title, time, image, imageAlt, paragraphs, links }] -> encart illustré sur fond
//   clair, pour un sujet qui mérite un texte suivi et pas une carte de lieu.
// archives: { title, intro, items: [{ src, alt, caption }] } -> planche de documents
//   de famille, chaque pièce dans son cadre avec sa légende.
const { t, page, title, intro, sections = [], paragraphs = [], image, imageAlt, postcard, features = [], archives } = Astro.props;

// item.to : { href, label } -> lien vers une autre page du site. Le href s'écrit
// depuis la racine de la langue ('/manger/'), le préfixe /en est ajouté ici.
const base = t.lang === 'en' ? '/en' : '';

// section.tab : libellé d'onglet. Dès qu'une rubrique en porte un, la page se
// range en onglets et les rubriques qui partagent un libellé finissent dans le
// même panneau. Sans JavaScript, tous les panneaux restent visibles à la suite,
// donc le contenu est là pour les moteurs comme pour un navigateur sans script.
const slug = (s) =>
  s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase()
   .replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

const tabGroups = [];
for (const s of sections) {
  if (!s.tab) continue;
  let g = tabGroups.find((x) => x.label === s.tab);
  if (!g) {
    g = { label: s.tab, id: slug(s.tab), sections: [] };
    tabGroups.push(g);
  }
  g.sections.push(s);
}
// t.<page>.tabs : ordre d'affichage voulu. Un onglet absent de la liste passe
// à la fin, pour qu'une rubrique nouvelle ne disparaisse jamais en silence.
const tabOrder = Astro.props.tabs || [];
tabGroups.sort((a, b) => {
  const ia = tabOrder.indexOf(a.label), ib = tabOrder.indexOf(b.label);
  return (ia < 0 ? 99 : ia) - (ib < 0 ? 99 : ib);
});
const hasTabs = tabGroups.length > 1;
const plainSections = hasTabs ? sections.filter((s) => !s.tab) : sections;

---

<Nav t={t} page={page} variant="solid" />

<main>
  <header class="page-head">
    <h1>{title}</h1>
    <p class="intro">{intro}</p>
  </header>

  {image && (
    <section class="section page-photo">
      <img src={image} alt={imageAlt} />
    </section>
  )}

  {/* Un élément de paragraphs peut être une chaîne, ou un objet
      { images: [{src, alt}], caption } : une figure qui vient s'intercaler dans
      le texte, calée à droite sur large écran et pleine largeur sur mobile. */}
  {paragraphs.length > 0 && (
    <section class="section prose">
      {paragraphs.map((p) => typeof p === 'string' ? <p>{p}</p> : (
        <figure class="prose-figure">
          <div class="prose-figure-imgs" data-count={p.images.length}>
            {p.images.map((im) => <img src={im.src} alt={im.alt} />)}
          </div>
          {p.caption && <figcaption>{p.caption}</figcaption>}
        </figure>
      ))}
    </section>
  )}

  {postcard && (
    <section class="section postcard-wrap">
      <figure class="postcard">
        <img src={postcard.src} alt={postcard.alt} loading="lazy" />
        <figcaption>{postcard.caption}</figcaption>
      </figure>
    </section>
  )}

  {archives && (
    <section class="section-alt archives-wrap">
      <div class="archives-head">
        <h2>{archives.title}</h2>
        {archives.intro && <p class="intro">{archives.intro}</p>}
      </div>
      <div class="archives">
        {/* Pas de loading="lazy" ici : les documents ont des formats très
            différents, donc pas de dimensions déclarées, donc une hauteur nulle
            avant chargement. Toute la grille s'effondrait à quelques pixels et
            le navigateur ne déclenchait jamais le chargement. Deux ou trois
            images par page, on peut les charger franchement. */}
        {archives.items.map((a) => (
          <figure class="archive">
            <img src={a.src} alt={a.alt} />
            <figcaption>{a.caption}</figcaption>
          </figure>
        ))}
      </div>
    </section>
  )}

  {features.map((f) => (
    <section class="section-alt feature-wrap">
      <article class="feature">
        {/* f.images : photos supplémentaires sous la principale, dans la même
            colonne. C'est le bloc qui est collant, pas l'image, sinon la
            deuxième se décrocherait au défilement. */}
        {(f.image || f.images) && (
          <div class="feature-media">
            {f.image && <img src={f.image} alt={f.imageAlt} />}
            {/* Pas de lazy, même raison que sur les planches d'archives : sans
                dimensions déclarées, la figure fait zéro pixel de haut et le
                chargement ne se déclenche jamais. */}
            {(f.images || []).map((im) => (
              <figure class="feature-extra">
                <img src={im.src} alt={im.alt} />
                {im.caption && <figcaption>{im.caption}</figcaption>}
              </figure>
            ))}
          </div>
        )}
        <div class="feature-body">
          <div class="card-head">
            <h2>{f.title}</h2>
            {f.time && <span class="card-time">{f.time}</span>}
          </div>
          {f.paragraphs.map((p) => <p>{p}</p>)}
          {f.links && (
            <p class="maps-link">
              {f.links.map((l) => <a href={l.url} target="_blank" rel="noopener">{l.label} ↗</a>)}
            </p>
          )}
        </div>
      </article>
    </section>
  ))}

  {plainSections.map((s) => (
    <section class="section">
      <Section t={t} s={s} base={base} />
    </section>
  ))}

  {hasTabs && (
    <div class="tabs" data-tabs>
      <div class="tablist" role="tablist" aria-label={t.lang === 'en' ? 'Sports' : 'Les sports'}>
        {tabGroups.map((g, i) => (
          <button
            class="tab"
            role="tab"
            type="button"
            id={`tab-${g.id}`}
            aria-controls={`panel-${g.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
          >{g.label}</button>
        ))}
      </div>
      {tabGroups.map((g) => (
        <section class="section tabpanel" role="tabpanel" id={`panel-${g.id}`} aria-labelledby={`tab-${g.id}`}>
          {g.sections.map((s) => <Section t={t} s={s} base={base} />)}
        </section>
      ))}
    </div>
  )}

  <Cta t={t} />
</main>

<Footer t={t} page={page} />

<script>
  // Onglets : sans ce script la page reste une suite de rubriques et la barre
  // d'onglets est masquée en CSS, donc pas de boutons morts. Le script l'allume,
  // n'en laisse qu'un panneau visible, et gère le clavier et l'ancre d'URL.
  const box = document.querySelector('[data-tabs]');
  if (box) {
    const tabs = [...box.querySelectorAll('[role="tab"]')];
    const panels = tabs.map((t) => document.getElementById(t.getAttribute('aria-controls')));

    const select = (i, { focus = false, push = false } = {}) => {
      tabs.forEach((t, k) => {
        t.setAttribute('aria-selected', k === i ? 'true' : 'false');
        t.tabIndex = k === i ? 0 : -1;
        panels[k].hidden = k !== i;
      });
      if (focus) tabs[i].focus();
      // replaceState et pas de saut : changer d'onglet ne doit pas faire défiler
      // la page ni empiler des entrées dans l'historique du navigateur.
      if (push) history.replaceState(null, '', '#' + panels[i].id.replace(/^panel-/, ''));
    };

    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i, { push: true }));
      t.addEventListener('keydown', (e) => {
        const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (step) {
          e.preventDefault();
          select((i + step + tabs.length) % tabs.length, { focus: true, push: true });
        }
      });
    });

    // Une URL du genre /bouger/#canyoning ouvre directement le bon onglet.
    const wanted = decodeURIComponent(location.hash.replace(/^#(panel-)?/, ''));
    const start = Math.max(0, panels.findIndex((p) => p.id === 'panel-' + wanted));
    box.classList.add('tabs-on');
    select(start);
  }
</script>
