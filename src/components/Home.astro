---
import villa from '../data/villa.json';
import reviews from '../data/reviews.json';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import Cta from './Cta.astro';

const { t } = Astro.props;

const gallery = [
  { src: 'piscine', altFr: 'Piscine au sel 4x9m avec pool house', altEn: 'Saltwater pool with pool house' },
  { src: 'salon', altFr: 'Grand salon lumineux ouvert sur le jardin', altEn: 'Spacious living room opening onto the garden' },
  { src: 'salon-salle-a-manger', altFr: 'Salon et salle à manger', altEn: 'Living and dining area' },
  { src: 'salle-a-manger', altFr: 'Salle à manger avec grande table familiale', altEn: 'Dining room with large family table' },
  { src: 'cuisine', altFr: 'Cuisine entièrement équipée avec bar', altEn: 'Fully equipped kitchen with bar' },
  { src: 'terrasse', altFr: 'Terrasse de la cuisine d\'été avec coin repas', altEn: 'Summer kitchen terrace with dining area' },
  { src: 'suite-parentale', altFr: 'Suite parentale avec lit queen 160x200', altEn: 'Master suite with queen bed' },
  { src: 'chambre-vue-mer', altFr: 'Chambre avec vue mer et balcon', altEn: 'Bedroom with sea view and balcony' },
  { src: 'chambre-double-montagne', altFr: 'Chambre double vue montagne', altEn: 'Mountain-view double bedroom' },
  { src: 'chambre-double-fleurie', altFr: 'Chambre double', altEn: 'Double bedroom' },
  { src: 'chambre-enfants', altFr: 'Chambre enfants avec trois couchages', altEn: "Kids' room sleeping three" },
  { src: 'salle-de-bain', altFr: 'Salle de douche moderne', altEn: 'Modern shower room' },
  { src: 'coin-musique', altFr: 'Coin musique : piano numérique et guitares', altEn: 'Music corner: digital piano and guitars' },
  { src: 'balcon-chambres', altFr: 'Balcon des chambres avec vue mer', altEn: 'Bedroom balcony with sea view' },
  { src: 'balcon-arche', altFr: 'Balcon sous l\'arche', altEn: 'Balcony under the arch' },
  { src: 'ping-pong', altFr: 'Table de ping-pong sous l\'olivier', altEn: 'Ping-pong table under the olive tree' },
  { src: 'barbecue', altFr: 'Barbecue à charbon', altEn: 'Charcoal barbecue' },
  { src: 'douche-exterieure', altFr: 'Douche extérieure', altEn: 'Outdoor shower' },
  { src: 'jardin-figuier', altFr: 'Jardin sous le figuier', altEn: 'Garden under the fig tree' },
  { src: 'jardin-cedre', altFr: 'Jardin sous le cèdre centenaire', altEn: 'Garden under the century-old cedar' },
  { src: 'jardin-facade-arriere', altFr: 'Jardin clos de 2500 m²', altEn: 'Fully fenced 2,500 m² garden' },
  { src: 'portail', altFr: 'Portail d\'entrée sous les pins', altEn: 'Entrance gate under the pines' },
  { src: 'vue-montagne', altFr: 'Vue sur les Albères', altEn: 'View of the Albères mountains' },
  { src: 'coucher-soleil', altFr: 'Coucher de soleil sur les Albères', altEn: 'Sunset over the Albères' },
];
const alt = (g) => (t.lang === 'en' ? g.altEn : g.altFr);
---

<header class="hero">
  <img class="hero-img" src="/photos/facade.jpg" alt={t.lang === 'en' ? 'Villa Horizons front view' : 'Villa Horizons vue de face'} />
  <div class="hero-overlay">
    <Nav t={t} page="home" variant="overlay" />
    <div class="hero-text">
      <h1>{t.hero.title}</h1>
      <p class="hero-subtitle">{t.hero.subtitle}</p>
      <p class="hero-tagline">{t.hero.tagline}</p>
      <ul class="badges">
        {t.hero.badges.map((b) => <li>{b}</li>)}
      </ul>
      <a class="btn" href={villa.airbnbUrl} target="_blank" rel="noopener">{t.hero.cta}</a>
    </div>
  </div>
</header>

<main>
  <section id="villa" class="section">
    <h2>{t.villa.title}</h2>
    <p class="intro">{t.villa.intro}</p>
    <div class="two-col">
      <div>
        <h3>{t.villa.groundFloorTitle}</h3>
        <ul>
          {t.villa.groundFloor.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div>
        <h3>{t.villa.floorTitle}</h3>
        <ul class="bedrooms">
          {t.villa.bedrooms.map((b) => (
            <li>
              <strong>{b.name}.</strong> {b.desc}
            </li>
          ))}
        </ul>
        <p>{t.villa.floorExtras}</p>
      </div>
    </div>
  </section>

  <section id="vie" class="section section-alt">
    <h2>{t.villa.lifeTitle}</h2>
    <p class="intro">{t.villa.lifeIntro}</p>
    <div class="cards">
      {t.villa.life.map((item) => (
        <div class="card">
          <h3>{item.name}</h3>
          <p>{item.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="gallery">
    {gallery.map((g) => (
      <img src={`/photos/${g.src}.jpg`} alt={alt(g)} loading="lazy" />
    ))}
  </section>

  <section id="exterieurs" class="section">
    <h2>{t.exterieur.title}</h2>
    <div class="cards">
      {t.exterieur.items.map((item) => (
        <div class="card">
          <h3>{item.name}</h3>
          <p>{item.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <section id="services" class="section section-alt">
    <h2>{t.services.title}</h2>
    <p class="intro">{t.services.intro}</p>
    <div class="cards">
      {t.services.items.map((item) => (
        <div class="card">
          <h3>{item.name}</h3>
          <p>{item.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <section id="avis" class="section">
    <h2>{t.avis.title}</h2>
    {reviews.reviewCount > 0 ? (
      <>
        <p class="intro">
          ★ {reviews.ratingValue} · {reviews.reviewCount} {t.lang === 'en' ? 'reviews on Airbnb' : 'avis sur Airbnb'}
        </p>
        <div class="cards">
          {reviews.reviews.slice(0, 6).map((r) => (
            <blockquote class="card review">
              <p>{r.text}</p>
              <footer>
                {r.author} · {r.date}
              </footer>
            </blockquote>
          ))}
        </div>
      </>
    ) : (
      <p class="intro">{t.avis.empty}</p>
    )}
    <p>
      <a class="btn btn-secondary" href={villa.airbnbUrl} target="_blank" rel="noopener">{t.avis.cta}</a>
    </p>
  </section>

  <section id="faq" class="section section-alt">
    <h2>{t.faq.title}</h2>
    <div class="faq">
      {t.faq.items.map((item) => (
        <details>
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section id="infos" class="section">
    <h2>{t.infos.title}</h2>
    <ul>
      {t.infos.items.map((i) => <li>{i}</li>)}
    </ul>
  </section>

  <section id="acces" class="section section-alt">
    <h2>{t.acces.title}</h2>
    <p class="intro">{t.acces.intro}</p>
    <div class="cards">
      {t.acces.items.map((item) => (
        <div class="card">
          <h3>{item.name}</h3>
          <p>{item.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <Cta t={t} />
</main>

<Footer t={t} page="home" />
