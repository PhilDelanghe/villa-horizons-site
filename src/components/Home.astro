const alt = (g) => (t.lang === 'en' ? g.altEn : g.altFr);

// Bandeau tournant : les photos défilent en fondu, en CSS pur.
// Versions allégées dédiées dans /photos/hero/, l'original reste réservé à la galerie.
const heroPhotos = [
  { src: 'facade-bougainvillier', altFr: 'Villa Horizons et son bougainvillier', altEn: 'Villa Horizons and its bougainvillea' },
  { src: 'vue-montagne', altFr: 'Les Albères vues de la villa', altEn: 'The Albères seen from the villa' },
  { src: 'piscine', altFr: 'La piscine au sel et son pool house', altEn: 'The saltwater pool and its pool house' },
  { src: 'coucher-soleil', altFr: 'Coucher de soleil sur les Albères', altEn: 'Sunset over the Albères' },
];
---

<header class="hero">
  <div class="hero-slides" style={`--slide-count: ${heroPhotos.length}`}>
    {heroPhotos.map((p, i) => (
      <img
        class="hero-img"
        src={`/photos/hero/${p.src}.jpg`}
        alt={alt(p)}
        style={`--slide-index: ${i}`}
        fetchpriority={i === 0 ? 'high' : undefined}
      />
    ))}
  </div>
  <div class="hero-overlay">
    <Nav t={t} page="home" variant="overlay" />
    <div class="hero-text">
      <h1>{t.hero.title}</h1>
      <p class="hero-subtitle">{t.hero.subtitle}</p>
      <p class="hero-tagline">{t.hero.tagline}</p>
      <ul class="badges">
        {t.hero.badges.map((b) => <li>{b}</li>)}
      </ul>
      <a class="btn" href={`${villa.superhoteUrl}?lang=${t.lang}`} target="_blank" rel="noopener">{t.hero.cta}</a>
    </div>
  </div>
</header>

<main>
  <section id="villa" class="section">
    <h2>{t.villa.title}</h2>
    <p class="intro">{t.villa.intro}</p>
    <div class="two-col">
      <div>
        <h3>{t.villa.groundFloorTitle}</h3>
        <ul>
          {t.villa.groundFloor.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div>
        <h3>{t.villa.floorTitle}</h3>
        <ul class="bedrooms">
          {t.villa.bedrooms.map((b) => (
            <li>
              <strong>{b.name}.</strong> {b.desc}
            </li>
          ))}
        </ul>
        <p>{t.villa.floorExtras}</p>
      </div>
    </div>
  </section>

  <section id="vie" class="section section-alt">
    <h2>{t.villa.lifeTitle}</h2>
    <p class="intro">{t.villa.lifeIntro}</p>
    <div class="cards">
      {t.villa.life.map((item) => (
        <div class="card">
          <h3>{item.name}</h3>
          <p>{item.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="gallery-wrap">
    {galleryGroups.map((group) => (
      <div class="gallery-group">
        <h3>{t.galerie[group.key]}</h3>
        <div class="carousel">
          <button class="carousel-btn carousel-prev" type="button" aria-label={t.lang === 'en' ? 'Previous photos' : 'Photos précédentes'} hidden>&#8249;</button>
          <div class="carousel-track">
            {group.photos.map((g) => (
              <img src={`/photos/${g.src}.jpg`} alt={alt(g)} loading="lazy" />
            ))}
          </div>
          <button class="carousel-btn carousel-next" type="button" aria-label={t.lang === 'en' ? 'More photos' : 'Photos suivantes'} hidden>&#8250;</button>
        </div>
      </div>
    ))}
  </section>

  <section id="exterieurs" class="section">
    <h2>{t.exterieur.title}</h2>
    <div class="cards">
      {t.exterieur.items.map((item) => (
        <div class="card">
          <h3>{item.name}</h3>
          <p>{item.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <section id="services" class="section section-alt">
    <h2>{t.services.title}</h2>
    <p class="intro">{t.services.intro}</p>
    <div class="cards">
      {t.services.items.map((item) => (
        <div class="card">
          <h3>{item.name}</h3>
          <p>{item.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <section id="avis" class="section">
    <h2>{t.avis.title}</h2>
    {reviews.reviewCount > 0 ? (
      <>
        <p class="intro">
          ★ {reviews.ratingValue} · {reviews.reviewCount} {t.lang === 'en' ? 'reviews on Airbnb' : 'avis sur Airbnb'}
        </p>
        <div class="cards">
          {/* display: false dans reviews.json retire un avis de la page sans
              l'effacer de la donnée, pour qu'il ne revienne pas à la prochaine
              récupération depuis Airbnb. */}
          {reviews.reviews.filter((r) => r.display !== false).map((r) => (
            <blockquote class="card review">
              <p>{t.lang === 'en' ? r.textEn : r.text}</p>
              <footer>
                {r.author} · {t.lang === 'en' ? r.dateEn : r.date}
                {t.lang === 'en' && <span class="review-note"> (translated from French)</span>}
              </footer>
            </blockquote>
          ))}
        </div>
      </>
    ) : (
      <p class="intro">{t.avis.empty}</p>
    )}
    <p>
      <a class="btn btn-secondary" href={villa.airbnbUrl} target="_blank" rel="noopener">{t.avis.cta}</a>
    </p>
  </section>

  <section id="faq" class="section section-alt">
    <h2>{t.faq.title}</h2>
    <div class="faq">
      {t.faq.items.map((item) => (
        <details>
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section id="infos" class="section">
    <h2>{t.infos.title}</h2>
    <ul>
      {t.infos.items.map((i) => <li>{i}</li>)}
    </ul>
  </section>

  <section id="acces" class="section section-alt">
    <h2>{t.acces.title}</h2>
    <p class="intro">{t.acces.intro}</p>
    <div class="cards">
      {t.acces.items.map((item) => (
        <div class="card">
          <h3>{item.name}</h3>
          <p>{item.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <Cta t={t} />
</main>

<Footer t={t} page="home" />

<script>
  // Carrousels de la galerie. Le défilement lui-même est natif (scroll-snap),
  // ce script n'ajoute que les flèches, et les masque quand il n'y a rien à faire défiler.
  document.querySelectorAll('.carousel').forEach((carousel) => {
    const track = carousel.querySelector('.carousel-track');
    const prev = carousel.querySelector('.carousel-prev');
    const next = carousel.querySelector('.carousel-next');
    if (!track || !prev || !next) return;

    const step = () => Math.max(track.clientWidth * 0.8, 240);
    const update = () => {
      const scrollable = track.scrollWidth - track.clientWidth > 4;
      prev.hidden = !scrollable || track.scrollLeft <= 4;
      next.hidden = !scrollable || track.scrollLeft >= track.scrollWidth - track.clientWidth - 4;
    };

    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  });
</script>
