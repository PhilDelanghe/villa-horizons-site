---
import villa from '../data/villa.json';
import reviews from '../data/reviews.json';

const { t } = Astro.props;

const gallery = [
  { src: 'piscine', altFr: 'Piscine au sel 4x9m avec pool house', altEn: 'Saltwater pool with pool house' },
  { src: 'salon', altFr: 'Grand salon lumineux', altEn: 'Spacious light-filled living room' },
  { src: 'salon-tele', altFr: 'Salon télé avec Smart TV', altEn: 'TV room with Smart TV' },
  { src: 'salle-a-manger', altFr: 'Salle à manger avec grande table familiale', altEn: 'Dining room with large family table' },
  { src: 'cuisine', altFr: 'Cuisine entièrement équipée', altEn: 'Fully equipped kitchen' },
  { src: 'terrasse', altFr: 'Terrasse ombragée avec coin repas', altEn: 'Shaded terrace with dining area' },
  { src: 'suite-parentale', altFr: 'Suite parentale avec lit queen 160x200', altEn: 'Master suite with queen bed' },
  { src: 'chambre-vue-mer', altFr: 'Chambre avec vue mer et balcon', altEn: 'Bedroom with sea view and balcony' },
  { src: 'chambre-double', altFr: 'Chambre double', altEn: 'Double bedroom' },
  { src: 'chambre-enfants', altFr: 'Chambre enfants avec lits superposés', altEn: "Kids' room with bunk beds" },
  { src: 'salle-de-bain', altFr: 'Salle de bains avec baignoire et douche', altEn: 'Bathroom with bathtub and shower' },
  { src: 'balcon-chambres', altFr: 'Balcon des chambres avec vue mer', altEn: 'Bedroom balcony with sea view' },
  { src: 'jardin-cedre', altFr: 'Jardin sous le cèdre centenaire', altEn: 'Garden under the century-old cedar' },
  { src: 'jardin-facade-arriere', altFr: 'Jardin clos de 2500 m²', altEn: 'Fully fenced 2,500 m² garden' },
  { src: 'vue-montagne', altFr: 'Vue sur les Albères', altEn: 'View of the Albères mountains' },
];
const alt = (g) => (t.lang === 'en' ? g.altEn : g.altFr);
---

<header class="hero">
  <img class="hero-img" src="/photos/facade.jpg" alt={t.lang === 'en' ? 'Villa Horizons front view' : 'Villa Horizons vue de face'} />
  <div class="hero-overlay">
    <nav class="nav">
      <span class="nav-brand">{t.hero.title}</span>
      <div class="nav-links">
        <a href="#villa">{t.nav.villa}</a>
        <a href="#exterieurs">{t.nav.exterieur}</a>
        <a href="#avis">{t.nav.avis}</a>
        <a href="#region">{t.nav.region}</a>
        <a href="#faq">{t.nav.faq}</a>
        <a href="#contact" class="nav-cta">{t.nav.reserver}</a>
        <a href={t.footer.langSwitchHref} class="nav-lang">{t.lang === 'en' ? 'FR' : 'EN'}</a>
      </div>
    </nav>
    <div class="hero-text">
      <h1>{t.hero.title}</h1>
      <p class="hero-subtitle">{t.hero.subtitle}</p>
      <p class="hero-tagline">{t.hero.tagline}</p>
      <ul class="badges">
        {t.hero.badges.map((b) => <li>{b}</li>)}
      </ul>
      <a class="btn" href={villa.airbnbUrl} target="_blank" rel="noopener">{t.hero.cta}</a>
    </div>
  </div>
</header>

<main>
  <section id="villa" class="section">
    <h2>{t.villa.title}</h2>
    <p class="intro">{t.villa.intro}</p>
    <div class="two-col">
      <div>
        <h3>{t.villa.groundFloorTitle}</h3>
        <ul>
          {t.villa.groundFloor.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div>
        <h3>{t.villa.floorTitle}</h3>
        <ul class="bedrooms">
          {t.villa.bedrooms.map((b) => (
            <li>
              <strong>{b.name}.</strong> {b.desc}
            </li>
          ))}
        </ul>
        <p>{t.villa.floorExtras}</p>
      </div>
    </div>
  </section>

  <section class="gallery">
    {gallery.map((g) => (
      <img src={`/photos/${g.src}.jpg`} alt={alt(g)} loading="lazy" />
    ))}
  </section>

  <section id="exterieurs" class="section">
    <h2>{t.exterieur.title}</h2>
    <div class="cards">
      {t.exterieur.items.map((item) => (
        <div class="card">
          <h3>{item.name}</h3>
          <p>{item.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <section id="avis" class="section section-alt">
    <h2>{t.avis.title}</h2>
    {reviews.reviewCount > 0 ? (
      <>
        <p class="intro">
          ★ {reviews.ratingValue} · {reviews.reviewCount} {t.lang === 'en' ? 'reviews on Airbnb' : 'avis sur Airbnb'}
        </p>
        <div class="cards">
          {reviews.reviews.slice(0, 6).map((r) => (
            <blockquote class="card review">
              <p>{r.text}</p>
              <footer>
                {r.author} · {r.date}
              </footer>
            </blockquote>
          ))}
        </div>
      </>
    ) : (
      <p class="intro">{t.avis.empty}</p>
    )}
    <p>
      <a class="btn btn-secondary" href={villa.airbnbUrl} target="_blank" rel="noopener">{t.avis.cta}</a>
    </p>
  </section>

  <section id="region" class="section">
    <h2>{t.region.title}</h2>
    <p class="intro">{t.region.intro}</p>
    <div class="two-col">
      <div>
        <h3>{t.region.distancesTitle}</h3>
        <ul>
          {t.region.distances.map((d) => <li>{d}</li>)}
        </ul>
      </div>
      <div>
        <h3>{t.region.activitiesTitle}</h3>
        <ul>
          {t.region.activities.map((a) => <li>{a}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section id="faq" class="section section-alt">
    <h2>{t.faq.title}</h2>
    <div class="faq">
      {t.faq.items.map((item) => (
        <details>
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section id="infos" class="section">
    <h2>{t.infos.title}</h2>
    <ul>
      {t.infos.items.map((i) => <li>{i}</li>)}
    </ul>
  </section>

  <section id="contact" class="section section-contact">
    <h2>{t.contact.title}</h2>
    <p class="intro">{t.contact.body}</p>
    <p class="contact-ctas">
      <a class="btn" href={villa.airbnbUrl} target="_blank" rel="noopener">{t.contact.airbnbCta}</a>
      <a class="btn btn-secondary" href={`mailto:${villa.email}`}>{t.contact.emailCta}</a>
    </p>
  </section>
</main>

<footer class="footer">
  <p>{t.footer.line}</p>
  <p><a href={t.footer.langSwitchHref}>{t.footer.langSwitch}</a></p>
</footer>
