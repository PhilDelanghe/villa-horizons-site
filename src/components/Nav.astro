---
const { t, page = 'home', variant = 'solid' } = Astro.props;
const base = t.lang === 'en' ? '/en' : '';
const links = [
  { key: 'villa', href: `${base}/` },
  { key: 'village', href: `${base}/village/` },
  { key: 'culture', href: `${base}/culture/` },
  { key: 'vin', href: `${base}/vin/` },
  { key: 'sport', href: `${base}/sport/` },
  { key: 'apropos', href: `${base}/a-propos/` },
];
const switchHref = t.lang === 'en' ? `/${t.pages[page].path}` : `/en/${t.pages[page].path}`;
---

<nav class={`nav nav-${variant}`}>
  <a class="nav-brand" href={`${base}/`}>Villa Horizons</a>
  <div class="nav-links">
    {links.map((l) => <a href={l.href}>{t.nav[l.key]}</a>)}
    <a href={`${base}/#contact`} class="nav-cta">{t.nav.reserver}</a>
    <a href={switchHref} class="nav-lang">{t.lang === 'en' ? 'FR' : 'EN'}</a>
  </div>
</nav>
