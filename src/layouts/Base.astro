---
import villa from '../data/villa.json';
import reviews from '../data/reviews.json';
import '../styles/global.css';

const { t } = Astro.props;
const isEn = t.lang === 'en';
const canonical = isEn ? `${villa.url}/en/` : `${villa.url}/`;

const photos = [
  'facade', 'piscine', 'salon', 'terrasse', 'suite-parentale', 'jardin-cedre',
].map((p) => `${villa.url}/photos/${p}.jpg`);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'VacationRental',
  name: villa.name,
  url: canonical,
  sameAs: villa.airbnbUrl,
  image: photos,
  description: t.metaDescription,
  address: {
    '@type': 'PostalAddress',
    addressLocality: villa.locality,
    postalCode: villa.postalCode,
    addressRegion: villa.region,
    addressCountry: villa.country,
  },
  // Coordonnées approximatives (centre du village), volontairement pas l'adresse exacte
  geo: {
    '@type': 'GeoCoordinates',
    latitude: villa.geo.latitude,
    longitude: villa.geo.longitude,
  },
  containsPlace: {
    '@type': 'Accommodation',
    occupancy: { '@type': 'QuantitativeValue', value: villa.capacity },
    numberOfBedrooms: villa.bedrooms,
    numberOfBathroomsTotal: villa.bathrooms,
    floorSize: { '@type': 'QuantitativeValue', value: villa.surface, unitCode: 'MTK' },
  },
  petsAllowed: true,
  checkinTime: '17:00',
  checkoutTime: '10:00',
  amenityFeature: [
    'Saltwater swimming pool', 'Fully fenced garden (2500 m²)', 'Air conditioning (Airzone, per room)',
    'High-speed WiFi', 'Dedicated workspace with 27-inch monitor', 'Netflix, Canal+, Apple TV',
    'Fully equipped kitchen', 'Washing machine', 'Free private parking', 'BBQ', 'Pétanque court',
    'Ping-pong table', 'Pet-friendly', 'Electric gate', 'Sea view', 'Mountain view',
  ].map((name) => ({ '@type': 'LocationFeatureSpecification', name, value: true })),
  ...(reviews.reviewCount > 0
    ? {
        aggregateRating: {
          '@type': 'AggregateRating',
          ratingValue: reviews.ratingValue,
          reviewCount: reviews.reviewCount,
        },
      }
    : {}),
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: t.faq.items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<html lang={t.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.metaTitle}</title>
    <meta name="description" content={t.metaDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="fr" href={`${villa.url}/`} />
    <link rel="alternate" hreflang="en" href={`${villa.url}/en/`} />
    <link rel="alternate" hreflang="x-default" href={`${villa.url}/`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={t.metaTitle} />
    <meta property="og:description" content={t.metaDescription} />
    <meta property="og:image" content={`${villa.url}/photos/piscine.jpg`} />
    <meta property="og:url" content={canonical} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  </head>
  <body>
    <slot />
  </body>
</html>
