---
import Base from '../layouts/Base.astro';
import SubPage from '../components/SubPage.astro';
import t from '../i18n/fr.js';
---

<Base t={t} page="apropos">
  <SubPage archives={{ title: t.apropos.archivesTitle, intro: t.apropos.archivesIntro, items: t.apropos.archives }} t={t} page="apropos" title={t.apropos.title} intro={t.apropos.intro} image="/photos/philippe-suzana.jpg" imageAlt="Philippe et Suzana sur le sentier littoral" paragraphs={t.apropos.paragraphs} sections={[{ title: t.apropos.enjoyTitle, items: t.apropos.enjoy }]} />
</Base>
