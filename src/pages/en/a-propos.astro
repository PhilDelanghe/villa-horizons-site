---
import Base from '../../layouts/Base.astro';
import SubPage from '../../components/SubPage.astro';
import t from '../../i18n/en.js';
---

<Base t={t} page="apropos">
  <SubPage t={t} page="apropos" title={t.apropos.title} intro={t.apropos.intro} image="/photos/philippe-suzana.jpg" imageAlt="Philippe and Suzana on the coastal path" paragraphs={t.apropos.paragraphs} sections={[{ title: t.apropos.enjoyTitle, items: t.apropos.enjoy }]} />
</Base>
